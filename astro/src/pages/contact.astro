---
// astro/src/pages/contact.astro
//
// /contact/ — port of the Nuxt-era pages/contact.vue. The live site serves a
// custom contact page (NOT the bare Strapi `pages.contact` body), so this is a
// dedicated route: a static intro card + the ContactForm Vue island.
//
// `contact` is excluded from the [...slug].astro catch-all so this wins.

import BaseLayout from '~/layouts/BaseLayout.astro';
import ContactForm from '~/components/ContactForm.vue';
---

<BaseLayout
  title="Contact"
  description="Get in touch with the R3 (Restore, Reinvest, Renew) program team at the Illinois Criminal Justice Information Authority (ICJIA)."
>
  <section class="contact-page" aria-labelledby="contact-heading">
    <h1 id="contact-heading" class="contact-page__heading">Contact R3</h1>

    <div class="contact-page__card-wrap">
      <div class="contact-page__card">
        <h2 class="contact-page__card-title">Have R3 questions or need assistance?</h2>
        <p class="contact-page__card-text">
          Please fill out the form below, and we'll get back to you as soon as possible.
        </p>
        <h2 class="contact-page__card-title">R3 Email:</h2>
        <ul class="contact-page__email-list">
          <li>
            <a class="contact-page__email" href="mailto:CJA.R3Questions@illinois.gov">
              CJA.R3Questions@illinois.gov
            </a>
          </li>
        </ul>

        <!-- Language Access Plan (LAP) section. Title VI / federal LEP
             requirement for federally-funded programs. Onsite translation
             will return when an Illinois DoIT-licensed solution (WeGlot)
             is available; for now, language assistance is request-based
             via this email. Moved here from /translate/ when that page
             was retired in v1.0.6 (the dedicated Google Translate buttons
             stopped working when Google removed the URL-based translation
             feature in 2019). -->
        <h2 class="contact-page__card-title">Need language assistance?</h2>
        <p class="contact-page__card-text">
          ICJIA provides free language assistance services to individuals whose
          primary language is not English, including qualified interpreters and
          document translation, in support of the federal Limited English
          Proficiency (LEP) guidance.
        </p>
        <h2 class="contact-page__card-title">Language Access Email:</h2>
        <ul class="contact-page__email-list">
          <li>
            <a class="contact-page__email" href="mailto:LAPRequests@illinois.gov">
              LAPRequests@illinois.gov
            </a>
          </li>
        </ul>
      </div>
    </div>

    <ContactForm client:load />
  </section>
</BaseLayout>

<style>
  .contact-page {
    max-width: 1080px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }

  .contact-page__heading {
    color: #0c0c0c;
  }

  /* The Nuxt card sat inside a `px-16` wrapper (64px inset) with 35px top /
     105px bottom margin. */
  .contact-page__card-wrap {
    padding: 0 4rem;
  }
  @media (max-width: 768px) {
    .contact-page__card-wrap {
      padding: 0;
    }
  }

  .contact-page__card {
    background: #093356;
    color: #ffffff;
    padding: 1.75rem 2.5rem 2.5rem;
    margin: 35px 0 105px;
    border-radius: 4px;
    box-shadow: 0 11px 15px rgba(0, 0, 0, 0.2), 0 9px 46px rgba(0, 0, 0, 0.12);
  }
  @media (max-width: 768px) {
    .contact-page__card {
      padding: 1.5rem;
      margin: 1.5rem 0 3rem;
    }
  }

  .contact-page__card-title {
    color: #ffffff;
    margin: 0 0 0.5rem;
  }
  .contact-page__card-title:not(:first-child) {
    margin-top: 1.25rem;
  }

  .contact-page__card-text {
    margin: 0 0 0.5rem;
    padding-left: 0.75rem;
  }

  .contact-page__email-list {
    margin: 0.5rem 0 0;
  }
  .contact-page__email-list li {
    margin: 8px 0;
  }

  .contact-page__email {
    color: #ffffff;
    text-decoration: underline;
    font-weight: 700;
    display: inline-block;
    min-height: 44px;
    line-height: 44px;
  }
  .contact-page__email:hover {
    color: #e6e6e6;
  }
</style>
