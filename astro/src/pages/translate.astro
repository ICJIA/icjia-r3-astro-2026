---
// astro/src/pages/translate.astro
//
// Translation page: five language buttons that open Google Translate
// in a new tab for the five most commonly spoken languages in Illinois.
// Matches pages/translate.vue from the legacy Nuxt site.

import BaseLayout from '~/layouts/BaseLayout.astro';

const SITE_URL = 'https://r3.illinois.gov';

const languages = [
  { name: 'Spanish',            code: 'es'    },
  { name: 'Polish',             code: 'pl'    },
  { name: 'Chinese (Simplified)', code: 'zh-CN' },
  { name: 'Tagalog',            code: 'tl'    },
  { name: 'Arabic',             code: 'ar'    },
];
---

<BaseLayout
  title="Translation Options - R3 Program"
  description="Translate the R3 (Restore, Reinvest, Renew) program website into Spanish, Polish, Chinese, Tagalog, or Arabic using Google Translate."
>
  <!-- Page-level skip links -->
  <nav aria-label="Translation page navigation" class="page-skip-links">
    <a href="#language-selection" class="page-skip-link">Skip to language selection</a>
    <a href="#translation-info" class="page-skip-link">Skip to translation information</a>
  </nav>

  <div class="page-wrap">
    <h1>Translation Options</h1>

    <!-- Language Selection Section -->
    <div
      id="language-selection"
      tabindex="-1"
      class="language-section"
      role="region"
      aria-labelledby="language-heading"
    >
      <h2 id="language-heading" class="sr-only">Select a language to translate this page</h2>
      <p class="sr-only">
        Choose one of the five most commonly spoken languages in Illinois to translate this page
        using Google Translate.
      </p>

      <div class="language-grid">
        {languages.map((lang) => (
          <a
            id={`language-btn-${lang.code}`}
            href={`https://translate.google.com/translate?hl=en&sl=en&u=${SITE_URL}&tl=${lang.code}`}
            target="_blank"
            rel="noopener noreferrer"
            class="translate-button"
            aria-label={`Translate page to ${lang.name}. Opens in new window.`}
          >
            {lang.name}
            <span class="sr-only">(opens in new window)</span>
          </a>
        ))}
      </div>
    </div>

    <hr class="divider" role="separator" aria-orientation="horizontal" />

    <!-- Translation Information Section -->
    <div
      id="translation-info"
      tabindex="-1"
      class="info-section"
      role="region"
      aria-labelledby="info-heading"
    >
      <h2 id="info-heading" class="sr-only">Translation Information</h2>
      <div class="info-body">
        <p>
          The Illinois Criminal Justice Information Authority ('ICJIA') offers translations of the
          content through Google Translate. Because Google Translate is an external website, ICJIA
          does not control the quality or accuracy of translated content. All ICJIA content is
          filtered through Google Translate which may result in unexpected and unpredictable
          degradation of portions of text, images and the general appearance on translated pages.
          Google Translate may maintain unique privacy and use policies. These policies are not
          controlled by ICJIA and are not associated with ICJIA's privacy and use policies.
        </p>
        <p>
          ICJIA would like to ensure that it provides Limited English Proficiency (LEP) individuals
          with meaningful and universal access to ICJIA services, programs, and activities by all
          persons, including those who self-identify as an LEP individual or have a preference for
          information and materials in a language other than English. To support its goals of being
          inclusive and accessible to all, ICJIA provides free language assistance services to
          individuals whose primary language is not English. Language assistance services include
          providing qualified interpreters and translating documents to ease access to important
          information about ICJIA programs, benefits, and activities.
        </p>
        <div class="contact-block">
          If you need additional language assistance services for this website, please email:
          <a
            href="mailto:LAPRequests@illinois.gov"
            aria-label="LAPRequests@illinois.gov, email for language assistance"
            class="contact-link"
          >
            LAPRequests@illinois.gov
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Page-level skip links (in addition to global skip-links in BaseLayout) */
  .page-skip-links {
    position: absolute;
    top: -100px;
    left: 0;
    z-index: 1000;
  }

  .page-skip-link {
    position: absolute;
    top: 0;
    left: 0;
    background: #0d4474;
    color: #fff;
    padding: 12px 24px;
    text-decoration: none;
    font-weight: 600;
    border-radius: 0 0 4px 0;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    z-index: 1001;
    clip: rect(0, 0, 0, 0);
    overflow: hidden;
  }

  .page-skip-link:focus {
    position: relative;
    top: 0;
    left: 0;
    clip: auto;
    overflow: visible;
    outline: 3px solid #fff;
    outline-offset: 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .page-wrap {
    max-width: 720px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }

  .language-section {
    margin-top: 24px;
    margin-bottom: 24px;
  }

  .language-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 1rem;
  }

  .translate-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 200px;
    min-height: 44px;
    padding: 8px 20px;
    border: 2px solid #0d4474;
    border-radius: 4px;
    color: #0d4474;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    background: transparent;
    transition: all 0.2s ease;
  }

  .translate-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
    background: #0d4474;
    color: #fff;
  }

  .translate-button:focus-visible {
    outline: 3px solid #0d4474;
    outline-offset: 2px;
  }

  .divider {
    border: none;
    border-top: 1px solid #e0e0e0;
    margin: 2rem 0;
  }

  .info-section {
    margin-top: 24px;
  }

  .info-body {
    font-size: 16px;
    font-weight: 400;
  }

  .info-body p {
    margin-bottom: 1rem;
  }

  .contact-block {
    font-weight: 700;
    font-size: 16px;
    text-align: center;
    margin-top: 1rem;
  }

  .contact-link {
    color: #0d4474;
    text-decoration: underline;
    min-height: 44px;
    display: inline-block;
    padding: 4px 8px;
  }

  .contact-link:hover,
  .contact-link:focus {
    color: #062a47;
    text-decoration: underline;
  }

  .contact-link:focus-visible {
    outline: 2px solid #0d4474;
    outline-offset: 2px;
  }

  @media (max-width: 599px) {
    .translate-button {
      width: 100%;
      max-width: 300px;
    }
  }
</style>
