---
// astro/src/pages/resources/single-page.astro
//
// /resources/single-page/ — every resource on one page, each in its own
// bordered card. Port of the Nuxt pages/resources/single-page.vue. Ordered by
// the Strapi `ranking` field; noindex (a printable convenience view).

import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { renderMarkdown } from '~/lib/markdown';

const all = await getCollection('resources');
const sorted = [...all].sort(
  (a, b) => (a.data.ranking ?? 999) - (b.data.ranking ?? 999),
);
---

<BaseLayout
  title="Resources (Single Page)"
  description="Every R3 resource on a single page."
  noIndex
>
  <div class="page-wrap">
    <h1>R3 Resources (Single Page)</h1>
    {sorted.map((r) => (
      <section class="resource-block">
        <h2 id={r.data.slug}>{r.data.title}</h2>
        <div class="markdown-body resource-block__body" set:html={renderMarkdown(r.data.body ?? '')} />
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .page-wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }
  .resource-block {
    margin: 1.5rem auto;
    padding: 1rem 2rem 1.5rem;
    border: 1px solid #cccccc;
    border-radius: 4px;
    background: #ffffff;
  }
  @media (max-width: 600px) {
    .resource-block {
      padding: 1rem 1.25rem 1.5rem;
    }
  }
  .resource-block__body {
    padding-left: 1.25rem;
  }
  @media (max-width: 600px) {
    .resource-block__body {
      padding-left: 0;
    }
  }
</style>
