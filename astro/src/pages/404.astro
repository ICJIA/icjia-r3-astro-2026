---
// astro/src/pages/404.astro
//
// 404 page — port of the Nuxt pages/404.vue: a big "Oops" headline,
// "404 | Page not found" subheading, and a row of quick-link buttons.

import BaseLayout from '~/layouts/BaseLayout.astro';

const quickLinks = [
  { label: 'R3 Home',     href: '/' },
  { label: 'Eligibility', href: '/eligibility/' },
  { label: 'FAQs',        href: '/faqs/' },
  { label: 'Contact',     href: '/contact/' },
];
---

<BaseLayout title="Page not found" description="404 - Page not found" noIndex>
  <div class="not-found">
    <p class="not-found__oops">Oops</p>
    <h1 class="not-found__heading">404 | Page not found</h1>

    <form
      class="not-found__search"
      role="search"
      aria-label="Site search"
      method="get"
      action="/search/"
    >
      <label for="nf-search-input" class="not-found__search-label">
        Search the R3 site
      </label>
      <div class="not-found__search-row">
        <input
          id="nf-search-input"
          class="not-found__search-input"
          type="search"
          name="q"
          placeholder="Type a keyword and press Enter"
          autocomplete="off"
        />
        <button type="submit" class="not-found__search-button">Search</button>
      </div>
    </form>

    <nav class="not-found__links" aria-label="Quick links">
      {quickLinks.map((link) => (
        <a class="not-found__link" href={link.href}>{link.label}&nbsp;&raquo;</a>
      ))}
    </nav>

    <p class="not-found__help">
      Still can't find what you're looking for?
      <a href="/contact/">Contact us</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .not-found {
    max-width: 1080px;
    margin: 2rem auto 4rem;
    padding: 2rem 1rem;
    text-align: center;
  }

  .not-found__oops {
    margin: 0;
    font-family: Roboto, sans-serif;
    font-weight: 900;
    font-size: 120px;
    line-height: 1.1;
    color: #0d4474;
  }

  .not-found__heading {
    margin: 0 0 2rem;
    font-weight: 700;
    font-size: 48px;
    line-height: 1.2;
  }

  .not-found__search {
    max-width: 480px;
    margin: 0 auto 2.5rem;
    text-align: left;
  }

  .not-found__search-label {
    display: block;
    margin-bottom: 0.5rem;
    font-family: Roboto, sans-serif;
    font-weight: 600;
    color: #0d4474;
  }

  .not-found__search-row {
    display: flex;
    gap: 0.5rem;
  }

  .not-found__search-input {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    font-size: 1rem;
    border: 2px solid #0d4474;
    border-radius: 4px;
    background: #fff;
  }
  .not-found__search-input:focus-visible {
    outline: 3px solid #0d4474;
    outline-offset: 2px;
  }

  .not-found__search-button {
    flex: 0 0 auto;
    min-height: 44px;
    padding: 0 1rem;
    background: #0d4474;
    color: #fff;
    font-family: Roboto, sans-serif;
    font-weight: 700;
    border: 2px solid #0d4474;
    border-radius: 4px;
    cursor: pointer;
  }
  .not-found__search-button:hover {
    background: #0a3559;
  }
  .not-found__search-button:focus-visible {
    outline: 3px solid #0d4474;
    outline-offset: 2px;
  }

  .not-found__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .not-found__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 12px 16px;
    color: #0d4474;
    font-family: Roboto, sans-serif;
    font-weight: 700;
    text-decoration: none;
    border-radius: 4px;
    transition: background 0.15s ease;
  }
  .not-found__link:hover {
    background: rgba(13, 68, 116, 0.08);
    text-decoration: underline;
  }
  .not-found__link:focus-visible {
    outline: 3px solid #0d4474;
    outline-offset: 2px;
  }

  .not-found__help {
    margin: 2.5rem 0 0;
    font-family: Roboto, sans-serif;
    color: #555;
  }
  .not-found__help a {
    color: #0d4474;
    font-weight: 700;
  }

  @media (max-width: 600px) {
    .not-found__oops {
      font-size: 80px;
    }
    .not-found__heading {
      font-size: 32px;
    }
  }
</style>
