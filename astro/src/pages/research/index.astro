---
// astro/src/pages/research/index.astro
//
// Lists Research Hub articles (hubArticles collection — rows tagged
// 'r3', 'cannabis', or 'all research'). Articles link OUT to the live Hub
// site rather than being re-rendered locally — preserves current behavior.
//
// Hub article URL pattern verified against the legacy Nuxt pages/research/index.vue
// (gotoArticle function, line ~391):
//   https://icjia.illinois.gov/researchhub/articles/<slug>
// This is the canonical public Hub URL used by the production Nuxt site.

import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '~/lib/dateFormat';

const all = await getCollection('hubArticles');
const sorted = [...all].sort(
  (a, b) =>
    new Date(b.data.date ?? b.data.createdAt ?? 0).getTime() -
    new Date(a.data.date ?? a.data.createdAt ?? 0).getTime(),
);

function hubArticleURL(slug: string): string {
  // Canonical Hub article URL — matches legacy Nuxt gotoArticle() implementation.
  // Pattern: https://icjia.illinois.gov/researchhub/articles/<slug>
  return `https://icjia.illinois.gov/researchhub/articles/${slug}`;
}
---

<BaseLayout
  title="Research"
  description="ICJIA research hub articles tagged R3."
>
  <div class="page-wrap">
    <h1>Research</h1>
    <p>
      The <a href="https://icjia.illinois.gov" target="_blank" rel="noopener noreferrer">Illinois Criminal Justice Information Authority (ICJIA)</a>
      is the state's lead agency on justice funding and research.
      <a href="https://icjia.illinois.gov/researchhub" target="_blank" rel="noopener noreferrer">ICJIA's Research Hub</a>
      provides a host of resources (publications, continuums, dashboards, datasets)
      to support data-driven decision-making for improved outcomes.
    </p>
    <ul class="research-list" role="list">
      {sorted.map((a) => (
        <li class="research-card">
          <article>
            <time datetime={a.data.date ?? a.data.createdAt}>
              {formatDate(a.data.date ?? a.data.createdAt)}
            </time>
            <h2>
              <a href={hubArticleURL(a.data.slug)} rel="noopener noreferrer" target="_blank">
                {a.data.title}
              </a>
            </h2>
            {a.data.abstract && <p>{a.data.abstract}</p>}
          </article>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .page-wrap { max-width: 1080px; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
  .research-list { list-style: none; padding: 0; margin: 1.5rem 0; display: grid; gap: 1.5rem; }
  .research-card article {
    background: #fff;
    border: 1px solid var(--color-r3-card-border);
    border-radius: 6px;
    padding: 1rem 1.25rem;
  }
  .research-card time { font-size: 0.75rem; font-weight: 700; color: var(--color-r3-text-muted); }
  .research-card h2 { margin: 0.25rem 0 0.5rem; font-size: 1.125rem; line-height: 1.4; }
  .research-card h2 a { color: var(--color-r3-primary); text-decoration: underline; min-height: 44px; display: inline-flex; align-items: center; }
  .research-card p { margin: 0; line-height: 1.5; }
</style>
