---
// astro/src/pages/index.astro
//
// Real homepage — Phase 4g.3. Mirrors the Nuxt pages/index.vue layout:
//   1. Splash row (two NOFO cards from HOMEPAGE_SPLASH)
//   2. Strapi `pages.index` body content (markdown)
//   3. Director letter section (Director Adams photo + actual Nuxt prose)
//   4. Applicant Tools (HomePhotoBoxes) + News & Updates (latest 2 posts)
//
// LCP: first splash image is preloaded via BaseLayout preloadImages prop.

import BaseLayout from '~/layouts/BaseLayout.astro';
import HomeSplashCard from '~/components/HomeSplashCard.astro';
import HomePhotoBoxes from '~/components/HomePhotoBoxes.astro';
import NewsCard from '~/components/NewsCard.astro';
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import { renderMarkdown } from '~/lib/markdown';
import { HOMEPAGE_SPLASH } from '~/lib/manualPages';
import directorAdamsPhoto from '../assets/director-adams.jpg';

const homePage = await getEntry('pages', 'index');
const homeBody = homePage?.data.body ? renderMarkdown(homePage.data.body) : '';

const allNews = await getCollection('news');
const latestNews = [...allNews]
  .sort((a, b) => new Date(b.data.postDate).getTime() - new Date(a.data.postDate).getTime())
  .slice(0, 2);
---

<BaseLayout
  title="Restore. Reinvest. Renew."
  description="The R3 (Restore, Reinvest, and Renew) program invests in communities most affected by systemic racism and disinvestment through economic development, violence prevention, reentry, and civil legal aid services."
>
  <h1 class="sr-only">R3 Restore, Reinvest, Renew - Illinois Criminal Justice Information Authority</h1>

  <!-- Splash Images Section -->
  <section class="splash-row" aria-label="Funding opportunities">
    {HOMEPAGE_SPLASH.map((s, i) => (
      <HomeSplashCard {...s} preload={i === 0} cardIndex={i} />
    ))}
  </section>

  <!-- Strapi pages.index body content -->
  {homeBody && (
    <section class="home-body markdown-body" set:html={homeBody} />
  )}

  <!-- Director Letter Section -->
  <div class="director-letter-section">
    <div class="director-letter-inner">
      <h2>Letter From the Director</h2>
      <p>
        <Image
          src={directorAdamsPhoto}
          widths={[140, 280, 420]}
          sizes="140px"
          format="webp"
          width={140}
          height={140}
          alt="ICJIA Executive Director, Delrice Adams"
          class="director-photo"
          loading="lazy"
        />
        Thank you for visiting the Restore, Reinvest, Review (R3)
        program website. We appreciate your interest in the R3 mission
        of investing in communities most affected by systemic racism
        and disinvestment.
      </p>
      <p>
        In collaboration with Lt. Gov. Stratton and the Justice Equity
        and Opportunity Initiative, ICJIA has provided funding access
        and availability to over 400 new small, localized grassroots
        organizations that, without R3, may not have received state
        grants
      </p>
      <p>
        As we initiate our third R3 Notice of Funding Opportunity, we
        remain committed to ensuring equity, fairness, and opportunity
        in communities across the state. We will continue to empower
        organizations to create innovative programs and strategies
        that address the diverse needs of their communities and,
        ultimately, build a safer Illinois.
      </p>
      <div>
        <strong>Delrice Adams</strong><br />
        ICJIA Executive Director
      </div>
    </div>
  </div>

  <!-- Applicant Tools + News & Updates -->
  <div class="home-tools-row">
    <div class="home-tools-col">
      <h2>Applicant Tools</h2>
      <HomePhotoBoxes />
    </div>
    <div class="home-tools-col">
      <h2>News &amp; Updates</h2>
      <ul class="home-news-list" role="list">
        {latestNews.map((n) => (
          <li>
            <NewsCard
              title={n.data.title}
              postDate={n.data.postDate}
              summary={n.data.summary}
              href={n.data.path}
              compact
            />
          </li>
        ))}
      </ul>
      <p class="home-news-link">
        <a href="/news/">News archive&nbsp;&raquo;</a>
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  /* ── Splash row ─────────────────────────────────────────────────────── */
  .splash-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 0;
  }

  /* ── Strapi body content ────────────────────────────────────────────── */
  .home-body {
    max-width: 1080px;
    margin: 3rem auto;
    padding: 0 1rem;
  }

  /* ── Director letter ────────────────────────────────────────────────── */
  .director-letter-section {
    background: #ddd;
    border-bottom: 1px solid #aaa;
    padding: 0 12px 12px;
  }

  .director-letter-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 1.5rem 0;
  }

  .director-letter-inner h2 {
    margin-top: 0;
  }

  .director-photo {
    float: left;
    margin-right: 15px;
    border: 1px solid #888;
    border-radius: 80%;
  }

  /* clearfix so the section expands past the floated photo */
  .director-letter-inner::after {
    content: '';
    display: table;
    clear: both;
  }

  /* ── Applicant Tools + News ─────────────────────────────────────────── */
  .home-tools-row {
    background: #fafafa;
    border-top: 1px solid #aaa;
    padding: 2rem 1rem 3rem;
    min-height: 30vh;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 2rem;
    max-width: 1280px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (max-width: 768px) {
    .home-tools-row {
      grid-template-columns: 1fr;
    }
  }

  .home-tools-col h2 {
    margin-top: 0;
  }

  .home-news-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }

  .home-news-link {
    text-align: center;
    margin-top: 1.5rem;
  }

  .home-news-link a {
    color: var(--color-r3-primary, #0d4474);
    text-decoration: underline;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    min-width: 150px;
    padding: 0 24px;
  }
</style>
