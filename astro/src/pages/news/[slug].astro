---
// astro/src/pages/news/[slug].astro
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { renderMarkdown } from '~/lib/markdown';
import { formatDate } from '~/lib/dateFormat';
import { newsArticleSchema } from '~/lib/schemas';

export async function getStaticPaths() {
  const items = await getCollection('news');
  return items.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
const html = d.body ? renderMarkdown(d.body) : '';

const newsSchema = newsArticleSchema({
  title: d.title,
  description: d.summary ?? '',
  canonicalURL: new URL(d.path, Astro.site).toString(),
  datePublished: d.postDate,
  dateModified: d.updatedAt ?? d.postDate,
});
---

<BaseLayout
  title={d.title}
  description={d.summary ?? undefined}
  publishedAt={d.postDate}
  updatedAt={d.updatedAt}
>
  <article class="news-detail page-wrap">
    <time class="news-detail__date" datetime={d.postDate}>{formatDate(d.postDate)}</time>
    <h1>{d.title}</h1>
    <div class="markdown-body" set:html={html} />
  </article>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(newsSchema)} />
</BaseLayout>

<style>
  .page-wrap { max-width: 880px; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
  .news-detail__date { font-size: 0.875rem; font-weight: 900; color: var(--color-r3-text); display: block; margin-bottom: 0.5rem; }
</style>
