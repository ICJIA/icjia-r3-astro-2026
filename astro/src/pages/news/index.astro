---
// astro/src/pages/news/index.astro
//
// /news/ — port of the Nuxt pages/news/index.vue: an "News and Updates"
// heading over a single column of #fafafa news cards (date, title, summary,
// "Read more »"), newest first.

import BaseLayout from '~/layouts/BaseLayout.astro';
import NewsCard from '~/components/NewsCard.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('news');
const sorted = [...all].sort(
  (a, b) => new Date(b.data.postDate).getTime() - new Date(a.data.postDate).getTime(),
);
---

<BaseLayout
  title="News and Updates"
  description="Stay updated with the latest news, announcements, and reports from the R3 (Restore, Reinvest, Renew) program."
>
  <div class="page-wrap">
    <h1>News and Updates</h1>
    <ul class="news-list" role="list">
      {sorted.map((p) => (
        <li>
          <NewsCard
            title={p.data.title}
            postDate={p.data.postDate}
            summary={p.data.summary}
            href={p.data.path}
            headingLevel="h2"
          />
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .page-wrap { max-width: 1080px; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
  .news-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
    display: grid;
    gap: 2.5rem;
  }
</style>
