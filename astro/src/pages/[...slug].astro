---
// astro/src/pages/[...slug].astro
//
// Catch-all route for single Strapi `pages` rows: /privacy/, /board/,
// /collaboratives/, /eligibility/, /meetings/, /faqs/. Mirrors the Nuxt
// pages/[...slug].vue:
//   - <h1> + the rendered Strapi markdown body
//   - a right-hand "Navigation" TOC sidebar when showTableOfContents is set
//   - a "This page last updated" line on /board/
//
// /eligibility/ keeps its ArcGIS map embed inside the Strapi body markdown
// (the markdown.ts ArcGIS iframe whitelist renders it) — exactly as the live
// site does — so no separate MapEmbed component is injected.

import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { renderMarkdown } from '~/lib/markdown';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages
    // Slugs served by dedicated routes, NOT this catch-all:
    //   index   → index.astro (the homepage)
    //   funding → an astro.config.ts redirect to / (matches the live site)
    //   contact → contact.astro (the live /contact/ is a custom form page,
    //             not the bare Strapi `pages.contact` body)
    .filter(
      (p) =>
        p.data.slug !== 'index' &&
        p.data.slug !== 'funding' &&
        p.data.slug !== 'contact',
    )
    .map((p) => ({
      params: { slug: p.data.slug === 'index' ? undefined : p.data.slug },
      props: { entry: p },
    }));
}

const { entry } = Astro.props;
const data = entry.data;
const html = data.body ? renderMarkdown(data.body) : '';

// /eligibility/ uses the live site's fluid full-width layout. The Nuxt original
// renders the eligibility catch-all body inside a <v-container fluid>, so its
// ArcGIS StoryMap embed — and the body text — stretch the full viewport width
// (16px inset), not the 1080px column the other catch-all pages sit in here.
const isFluid = data.slug === 'eligibility';

// Build a "Navigation" table of contents from the body's <h2> headings
// (markdown-it-anchor gives each one a stable id) when the page opts in.
const showTOC = data.showTableOfContents === true;
const toc = showTOC
  ? [...html.matchAll(/<h2[^>]*\bid="([^"]+)"[^>]*>(.*?)<\/h2>/gs)].map((m) => ({
      id: m[1],
      text: m[2].replace(/<[^>]+>/g, '').trim(),
    }))
  : [];

// Approximates moment().fromNow() for the /board/ "last updated" line.
function relativeTime(iso: string | undefined): string {
  if (!iso) return '';
  const days = Math.floor((Date.now() - new Date(iso).getTime()) / 86_400_000);
  if (days < 1) return 'today';
  if (days < 30) return `${days} day${days === 1 ? '' : 's'} ago`;
  const months = Math.floor(days / 30);
  if (months < 12) return `${months} month${months === 1 ? '' : 's'} ago`;
  const years = Math.floor(days / 365);
  return `${years} year${years === 1 ? '' : 's'} ago`;
}
---

<BaseLayout
  title={data.title}
  description={data.summary ?? undefined}
  canonical={new URL(data.path, Astro.site).toString()}
  publishedAt={data.createdAt}
  updatedAt={data.updatedAt}
  preconnectOrigins={isFluid ? ['https://storymaps.arcgis.com'] : []}
>
  <div class:list={['page-layout', isFluid && 'page-layout--fluid', showTOC && toc.length > 0 && 'page-layout--has-toc']}>
    <div class="page-content">
      <h1>{data.title}</h1>
      <article class="markdown-body" set:html={html} />
      {data.slug === 'board' && (
        <p class="page-updated">
          This page last updated:&nbsp;{relativeTime(data.updatedAt)}
        </p>
      )}
    </div>

    {showTOC && toc.length > 0 && (
      <aside class="page-toc" aria-label="Page navigation">
        <a class="page-toc__heading" href="#main-content">Navigation</a>
        <ul role="list">
          {toc.map((h) => (
            <li><a class="page-toc__link" href={`#${h.id}`}>{h.text}</a></li>
          ))}
        </ul>
      </aside>
    )}
  </div>
</BaseLayout>

<style>
  .page-layout {
    max-width: 1080px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }

  /* /eligibility/ is full-width to match the live site's <v-container fluid>.
     The 1rem (16px) horizontal padding above already matches the original's
     16px container inset, so dropping the max-width is the whole change. */
  .page-layout--fluid {
    max-width: none;
  }

  /* Two-column layout when a TOC sidebar is present (Nuxt used 9 / 3 cols) */
  .page-layout--has-toc {
    max-width: 1280px;
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);
    gap: 2.5rem;
  }
  @media (max-width: 959.98px) {
    .page-layout--has-toc {
      grid-template-columns: 1fr;
    }
    /* The TOC sidebar is desktop-only, matching the Nuxt hidden-sm-and-down */
    .page-layout--has-toc .page-toc {
      display: none;
    }
  }

  .page-updated {
    margin-top: 3rem;
    text-align: right;
    font-size: 12px;
    font-weight: 700;
    color: var(--color-r3-text-muted, #555);
  }

  .page-toc {
    position: sticky;
    top: 115px;
    align-self: start;
    background: #fafafa;
    border-left: 1px solid #e9e9e9;
    padding: 1.25rem 1.25rem 2rem;
    font-size: 14px;
  }
  .page-toc__heading {
    display: block;
    margin-bottom: 1rem;
    font-size: 20px;
    font-weight: 700;
    color: var(--color-r3-text, #1a1a1a);
    text-decoration: none;
  }
  .page-toc__heading:hover {
    text-decoration: underline;
  }
  .page-toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .page-toc li {
    margin-bottom: 0.5rem;
  }
  .page-toc__link {
    color: var(--color-r3-primary, #0d4474);
    text-decoration: none;
  }
  .page-toc__link:hover {
    text-decoration: underline;
  }
  .page-toc__link:focus-visible {
    outline: 2px solid var(--color-r3-primary, #0d4474);
    outline-offset: 2px;
  }
</style>
