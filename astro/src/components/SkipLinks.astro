---
// astro/src/components/SkipLinks.astro
//
// Two skip links rendered before any other content. Visible only when
// keyboard-focused (clip-path reveal pattern). Direct port of the SSR-correct
// markup from app.vue lines 1-7 + 152-216 of the Nuxt build, which already
// passed every WCAG 2.1 AA check (March + April 2026 audits).
---

<nav aria-label="Skip navigation" class="skip-links">
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <a href="#navigation" class="skip-link">Skip to navigation</a>
</nav>

<style>
  .skip-links {
    position: relative;
    z-index: 9999;
  }

  .skip-link {
    position: absolute;
    top: -100px;
    left: 0;
    background: #000000 !important; /* Black background for maximum contrast with white text */
    color: #ffffff !important; /* White text for WCAG AAA compliance (21:1 contrast ratio) */
    padding: 12px 16px;
    text-decoration: none !important;
    border-radius: 0 0 4px 4px;
    font-weight: 700;
    font-size: 16px;
    z-index: 10000;
    transition: top 0.2s ease;
    /* Hide skip links by default - only show when keyboard focused */
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    width: auto;
    white-space: nowrap;
  }

  /* Show skip link when focused via keyboard */
  .skip-link:focus-visible {
    top: 0;
    clip: auto;
    clip-path: none;
    outline: 3px solid #ffffff;
    outline-offset: 2px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.5);
    background: #000000 !important; /* Black background for maximum contrast */
    color: #ffffff !important; /* White text */
  }

  /* Fallback for browsers that don't support :focus-visible */
  .skip-link:focus {
    top: 0;
    clip: auto;
    clip-path: none;
    outline: 3px solid #ffffff;
    outline-offset: 2px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.5);
    background: #000000 !important; /* Black background for maximum contrast */
    color: #ffffff !important; /* White text */
  }

  /* Hide when focused but not via keyboard (mouse clicks) */
  .skip-link:focus:not(:focus-visible) {
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    top: -100px;
  }

  .skip-link:hover {
    background: #333333 !important; /* Slightly lighter on hover, still high contrast */
    color: #ffffff !important;
    text-decoration: underline !important;
  }

  .skip-link:visited {
    color: #ffffff !important; /* Keep white even when visited */
  }
</style>
