---
// astro/src/components/HomeHero.astro
//
// Homepage hero band — the "no active NOFO" state of the splash slot.
//
// Replaces the two-up HomeSplashCard row with a single full-bleed photo and
// one centred panel pointing at the R3 StoryMap. Occupies the same 650px slot
// the splash row did, so nothing below it shifts when the site flips between
// the two (see SHOW_HOMEPAGE_SPLASH in lib/manualPages.ts).
//
// Contrast note: the panel is opaque rather than the translucent band the
// splash cards use, so text contrast is fixed by the panel colour instead of
// varying with whatever pixels sit behind it.

import { Image } from 'astro:assets';
import { R3_STORYMAP_URL } from '~/lib/navConfig';
import {
  HOME_HERO_IMAGE,
  HOME_HERO_WIDTHS,
  HOME_HERO_SIZES,
  HOME_HERO_FORMAT,
} from '~/lib/homeHero';

interface Props {
  href?: string;
}
const { href = R3_STORYMAP_URL } = Astro.props;
---

<section class="home-hero" aria-label="About the R3 program">
  <!-- The whole band is the link. Its accessible name is the panel's own text
       ("Learn More About the R3 Program Click here to explore…"), so the bare
       "Click here" never stands alone as link text. -->
  <a class="home-hero__link" href={href} target="_blank" rel="noopener noreferrer">
    <Image
      src={HOME_HERO_IMAGE}
      alt=""
      role="presentation"
      aria-hidden="true"
      widths={HOME_HERO_WIDTHS}
      sizes={HOME_HERO_SIZES}
      format={HOME_HERO_FORMAT}
      class="home-hero__img"
      loading="eager"
      fetchpriority="high"
    />

    <div class="home-hero__overlay">
      <div class="home-hero__panel">
        <h2 class="home-hero__title">Learn More About the R3 Program</h2>
        <p class="home-hero__text">
          Click here to explore where R3 funds go, how grantees serve their
          communities, the latest research on the R3 program, and more!<span
            class="sr-only"> (opens in a new tab)</span
          >
        </p>
      </div>
    </div>
  </a>
</section>

<style>
  .home-hero {
    position: relative;
    background: #ddd;
  }

  .home-hero__link {
    position: relative;
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .home-hero__link:focus-visible {
    outline: 3px solid var(--color-r3-primary, #0d4474);
    outline-offset: -3px;
  }

  .home-hero__img {
    display: block;
    width: 100%;
    height: 650px;
    object-fit: cover;
  }

  .home-hero__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  /* Opaque panel — mock uses #E8E8E8. Body text at #262626 on it is 12.6:1,
     the title at #1a1a1a is 14.6:1; both hold regardless of the photo. */
  .home-hero__panel {
    width: min(920px, 100%);
    padding: 1.75rem 2rem 2rem;
    background: #e8e8e8;
    border-radius: 4px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    text-align: center;
    transition: background-color 0.2s ease;
  }

  .home-hero__link:hover .home-hero__panel {
    background: #f5f5f5;
  }

  .home-hero__title {
    margin: 0 0 0.85rem;
    padding-bottom: 0.85rem;
    border-bottom: 2px solid var(--color-r3-primary, #0d4474);
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.2;
    color: #1a1a1a;
  }

  .home-hero__link:hover .home-hero__title {
    text-decoration: underline;
  }

  .home-hero__text {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: #262626;
  }

  /* The source photo is 2.18:1. Held at 650px tall, a narrow viewport would
     crop it to a vertical sliver, so the band shortens as the screen does. */
  @media (max-width: 959px) {
    .home-hero__img {
      height: 480px;
    }

    .home-hero__panel {
      padding: 1.5rem 1.5rem 1.75rem;
    }

    .home-hero__title {
      font-size: 1.6rem;
    }
  }

  @media (max-width: 600px) {
    .home-hero__img {
      height: 380px;
    }

    .home-hero__overlay {
      padding: 0.75rem;
    }

    .home-hero__panel {
      padding: 1.25rem 1rem 1.5rem;
    }

    .home-hero__title {
      font-size: 1.375rem;
    }

    .home-hero__text {
      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__panel {
      transition: none;
    }
  }
</style>
