---
// astro/src/components/SiteFooter.astro
//
// Two-band dark footer — faithful port of the live r3.illinois.gov footer
// (TheContextFooter.vue + TheFooter.vue):
//
//   Upper band  (#11568e) — footerMenu link strip, uppercase Raleway,
//                hidden below 960px (Nuxt `hidden-sm-and-down`).
//   Lower band  (#0e4474) — single centred legal line:
//                © {year} State of Illinois | Governor JB Pritzker |
//                Privacy | Accessibility | Contact | Translate
//
// Colours, link targets, and order match the Nuxt source exactly. White text
// on the dark bands clears WCAG AAA contrast. Every link is a ≥44px tap
// target (WCAG 2.5.5). The copyright year is computed at build time (UTC).

const year = new Date().getUTCFullYear();

// Mirror of app.config.js `footerMenu` (Nuxt source of truth).
interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
}

const footerLinks: FooterLink[] = [
  { label: 'Home',           href: '/' },
  { label: 'FAQs',           href: '/faqs/' },
  { label: 'News',           href: '/news/' },
  { label: 'Contact',        href: '/contact/' },
  { label: 'Meetings',       href: '/meetings/' },
  { label: 'Eligibility',    href: '/eligibility/' },
  { label: 'Collaboratives', href: '/collaboratives/' },
  { label: 'Research',       href: '/research/' },
  { label: 'Resources',      href: '/resources/' },
  { label: 'Search',         href: '/search/' },
  { label: 'Accessibility',  href: '/docs/accessibility/index.html', external: true },
];
---

<footer class="site-footer" role="contentinfo" aria-label="Site footer">
  <!--
    Upper band — footerMenu strip (TheContextFooter.vue).
    Hidden below 960px, matching the Nuxt `hidden-sm-and-down`.
  -->
  <nav class="site-footer__nav" aria-label="Footer navigation">
    <ul role="list" class="site-footer__nav-list">
      {footerLinks.map((item) => (
        <li>
          <a
            href={item.href}
            class="site-footer__nav-link"
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!--
    Lower band — single centred legal line (TheFooter.vue):
    © {year} State of Illinois | Governor JB Pritzker | Privacy |
    Accessibility | Contact | Translate
  -->
  <div class="site-footer__bottom">
    <span class="site-footer__copy">
      &copy;&nbsp;{year}&nbsp;<a
        href="https://www.illinois.gov"
        target="_blank"
        rel="noopener noreferrer"
        class="site-footer__legal-link">State of Illinois</a>
    </span>
    <span class="site-footer__sep" aria-hidden="true">|</span>
    <a
      href="https://www2.illinois.gov/sites/gov/Pages/default.aspx"
      target="_blank"
      rel="noopener noreferrer"
      class="site-footer__legal-link">Governor JB Pritzker</a>
    <span class="site-footer__sep" aria-hidden="true">|</span>
    <a href="/privacy/" class="site-footer__legal-link">Privacy</a>
    <span class="site-footer__sep" aria-hidden="true">|</span>
    <a href="/docs/accessibility/index.html" class="site-footer__legal-link">Accessibility</a>
    <span class="site-footer__sep" aria-hidden="true">|</span>
    <a href="/contact/" class="site-footer__legal-link">Contact</a>
    <span class="site-footer__sep" aria-hidden="true">|</span>
    <a href="/translate/" class="site-footer__legal-link">Translate</a>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
  }

  /* ── Upper nav band (#11568e) ────────────────────────────────────────── */
  .site-footer__nav {
    background: #11568e;
    padding: 0.25rem 1rem;
  }

  .site-footer__nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0;
  }

  .site-footer__nav-link {
    /* AAA contrast: white on #11568e */
    color: #ffffff !important;
    text-decoration: underline; /* matches the live footer's global link style */
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-family: 'Raleway Variable', Raleway, sans-serif;
    font-weight: 700;
    font-size: 14px;
    /* 44px tap target (WCAG 2.5.5) */
    display: inline-block;
    min-height: 44px;
    line-height: 44px;
    padding: 0 12px;
  }

  .site-footer__nav-link:hover {
    color: #cccccc !important;
  }

  .site-footer__nav-link:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
    border-radius: 2px;
    text-decoration: underline;
  }

  /* Hidden below 960px — matches Nuxt's `hidden-sm-and-down` */
  @media (max-width: 959.98px) {
    .site-footer__nav {
      display: none;
    }
  }

  /* ── Lower legal band (#0e4474) ──────────────────────────────────────── */
  .site-footer__bottom {
    background: #0e4474;
    padding: 0.5rem 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    line-height: 1.8;
    color: #ffffff;
    text-align: center;
  }

  .site-footer__copy {
    margin: 0;
    color: #ffffff;
    font-weight: 700;
  }

  .site-footer__sep {
    color: #ffffff;
    padding: 0 6px;
    font-weight: 700;
    user-select: none;
  }

  .site-footer__legal-link {
    /* AAA contrast: white on #0e4474 */
    color: #ffffff !important;
    font-weight: 700;
    text-decoration: underline; /* matches the live footer's global link style */
    /* 44px tap target (WCAG 2.5.5) */
    display: inline-block;
    min-height: 44px;
    padding: 8px 4px;
    line-height: 28px;
  }

  .site-footer__legal-link:hover {
    text-decoration: underline;
  }

  .site-footer__legal-link:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
    border-radius: 2px;
    text-decoration: underline;
  }
</style>
