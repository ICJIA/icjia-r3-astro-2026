---
// astro/src/components/Funding.astro
//
// Renders the R3 funding award tables consumed from
// public/R3_site_table_V2.json + public/r3-site-table-2024.json. Direct
// port of the table data displayed on the /funding/ page, minus Vuetify
// table wrappers.
//
// R3_site_table_V2.json columns (769 rows):
//   state | r3_funding_region | county | r3_zone_id | census_tract_name |
//   census_tract_geoid | service_delivery_minimum_funding_amount |
//   service_delivery_maximum_funding_amount |
//   planning_grant_minimum_funding_amount |
//   planning_grant_maximum_funding_amount | high_need_area
//
// r3-site-table-2024.json columns (906 rows):
//   R3 Area ID | R3 Funding Region | R3 Funding Region Name | GEOID |
//   Census Tract Name | High Need Area |
//   Tier 1 Funding Range | Tier 2 Funding Range | Tier 3 Funding Range

import siteTableV2Raw from '../../public/R3_site_table_V2.json';
import siteTable2024Raw from '../../public/r3-site-table-2024.json';

interface V2Row {
  state: string;
  r3_funding_region: string;
  county: string;
  r3_zone_id: number;
  census_tract_name: string;
  census_tract_geoid: number;
  service_delivery_minimum_funding_amount: string;
  service_delivery_maximum_funding_amount: string;
  planning_grant_minimum_funding_amount: string;
  planning_grant_maximum_funding_amount: string;
  high_need_area: string;
}

interface Row2024 {
  'R3 Area ID': number;
  'R3 Funding Region': number;
  'R3 Funding Region Name': string;
  GEOID: number;
  'Census Tract Name': string;
  'High Need Area': string;
  'Tier 1 Funding Range': string;
  'Tier 2 Funding Range': string;
  'Tier 3 Funding Range': string;
}

const v2 = siteTableV2Raw as V2Row[];
const v2024 = siteTable2024Raw as Row2024[];
---

<section class="funding">
  <h2>R3 Eligible Areas — Cohort One (V2)</h2>
  <p class="table-note">
    {v2.length.toLocaleString()} census tracts eligible for R3 service-delivery
    and planning grants.
  </p>

  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th scope="col">County</th>
          <th scope="col">Region</th>
          <th scope="col">Census Tract</th>
          <th scope="col">Zone ID</th>
          <th scope="col">High Need</th>
          <th scope="col">Service Delivery Min</th>
          <th scope="col">Service Delivery Max</th>
          <th scope="col">Planning Grant Min</th>
          <th scope="col">Planning Grant Max</th>
        </tr>
      </thead>
      <tbody>
        {v2.map((row) => (
          <tr>
            <td>{row.county}</td>
            <td>{row.r3_funding_region}</td>
            <td>{row.census_tract_name}</td>
            <td>{row.r3_zone_id}</td>
            <td class={row.high_need_area === 'Yes' ? 'high-need' : ''}>{row.high_need_area}</td>
            <td>{row.service_delivery_minimum_funding_amount}</td>
            <td>{row.service_delivery_maximum_funding_amount}</td>
            <td>{row.planning_grant_minimum_funding_amount}</td>
            <td>{row.planning_grant_maximum_funding_amount}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>R3 Eligible Areas — 2024</h2>
  <p class="table-note">
    {v2024.length.toLocaleString()} census tracts eligible for R3 funding in 2024.
  </p>

  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th scope="col">Area ID</th>
          <th scope="col">Region</th>
          <th scope="col">Region Name</th>
          <th scope="col">Census Tract</th>
          <th scope="col">High Need</th>
          <th scope="col">Tier 1 Range</th>
          <th scope="col">Tier 2 Range</th>
          <th scope="col">Tier 3 Range</th>
        </tr>
      </thead>
      <tbody>
        {v2024.map((row) => (
          <tr>
            <td>{row['R3 Area ID']}</td>
            <td>{row['R3 Funding Region']}</td>
            <td>{row['R3 Funding Region Name']}</td>
            <td>{row['Census Tract Name']}</td>
            <td class={row['High Need Area'] === 'Yes' ? 'high-need' : ''}>{row['High Need Area']}</td>
            <td>{row['Tier 1 Funding Range']}</td>
            <td>{row['Tier 2 Funding Range']}</td>
            <td>{row['Tier 3 Funding Range']}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .funding {
    margin: 1.5rem 0;
  }

  .funding h2 {
    font-size: 1.4rem;
    margin: 2rem 0 0.4rem;
    color: var(--color-r3-primary, #1a237e);
  }

  .table-note {
    font-size: 0.9rem;
    color: #555;
    margin: 0 0 0.75rem;
  }

  .table-wrapper {
    overflow-x: auto;
    margin-bottom: 2.5rem;
    border: 1px solid var(--color-r3-card-border, #ddd);
    border-radius: 4px;
  }

  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  th,
  td {
    text-align: left;
    border-bottom: 1px solid var(--color-r3-card-border, #ddd);
    border-right: 1px solid var(--color-r3-card-border, #ddd);
    padding: 0.45rem 0.65rem;
  }

  th:last-child,
  td:last-child {
    border-right: none;
  }

  thead tr {
    background: #f0f0f0;
  }

  th {
    font-weight: 600;
    position: sticky;
    top: 0;
    background: #f0f0f0;
    z-index: 1;
  }

  tbody tr:nth-child(even) td {
    background: #fafafa;
  }

  tbody tr:hover td {
    background: #e8f0fe;
  }

  td.high-need {
    color: #b71c1c;
    font-weight: 600;
  }
</style>
