# astro/.env.sample
#
# Public env vars consumed by astro/astro.config.ts via envField. Defaults
# defined there — this file documents the keys + staging-override gotchas.
#
# Copy to astro/.env (gitignored) for local override; otherwise the defaults
# in astro.config.ts apply. Production values are set in the Netlify build
# environment (root netlify.toml).

# Strapi GraphQL endpoint. Used at build time by src/lib/strapi.ts.
PUBLIC_API_BASE_URL=https://r3.icjia-api.cloud

# Research Hub GraphQL endpoint. Used at build time by the hubArticles loader.
PUBLIC_HUB_API_BASE_URL=https://researchhub.icjia-api.cloud

# Public site URL — used for canonical URLs, OG images, sitemap, JSON-LD.
# Override in staging/branch deploys to the deploy URL (e.g. via Netlify
# branch-deploy environment).
PUBLIC_BASE_URL=https://r3.illinois.gov

# Plausible script src host. Same on prod and staging.
PUBLIC_PLAUSIBLE_HOST=https://plausible.icjia.cloud

# IMPORTANT: When PUBLIC_BASE_URL is overridden for a staging or branch
# deploy, PUBLIC_PLAUSIBLE_DOMAIN MUST also be overridden — otherwise
# staging traffic fires against the production r3.illinois.gov Plausible
# bucket. Set this to the staging hostname (e.g. r3-staging.illinois.gov)
# for non-prod deploys.
PUBLIC_PLAUSIBLE_DOMAIN=r3.illinois.gov
