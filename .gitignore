# Root-level ignores. The Astro app carries its own astro/.gitignore for
# build output, generated types, test artifacts, env files, etc.
node_modules
.DS_Store
*.log

# Netlify CLI state (linked-site, deploy cache). Created wherever you run
# `netlify` commands — at the root and inside astro/ for this repo. Per
# Netlify's recommendation, never committed.
.netlify/
