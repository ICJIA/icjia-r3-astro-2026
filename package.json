{
  "name": "icjia-r3-v5-nuxt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Illinois Criminal Justice Information Authority",
    "email": "cja.info@illinois.gov"
  },
  "scripts": {
    "preflight": "node ./creators/checkNodeVersion.js",
    "ensure:docs": "node ./scripts/ensure-accessibility-report.js",
    "build": "yarn preflight && yarn ensure:docs && yarn scripts && nuxt build",
    "build:serve": "yarn preflight && yarn ensure:docs && yarn scripts && nuxt build && node .output/server/index.mjs",
    "clear:cache": "rm -rf .nuxt .output",
    "create:news": "node ./creators/createMarkdownNews.js",
    "create:pages": "node ./creators/createMarkdownPages.js",
    "create:resources": "node ./creators/createMarkdownResources.js",
    "create:faqs": "node ./creators/createMarkdownFaqs.js",
    "create:searchIndex": "node ./creators/createSearchIndex.js",
    "create:searchIndexFaqs": "node ./creators/createSearchIndexFaqs.js",
    "create:contentDirectory": "node ./creators/createContentDirectory.js",
    "create:sitemap": "node ./creators/createSitemap.js",
    "create:routes": "node ./creators/createSiteRoutes.js",
    "create:hub": "node ./creators/createHubArticles.js",
    "create:hubImages": "node ./creators/createHubImages.js",
    "create:manualPages": "node ./creators/createManualPages.js",
    "dev": "yarn preflight && yarn ensure:docs && yarn clear:cache && yarn scripts && nuxt dev --port=8000 -o",
    "dev:audit": "yarn preflight && yarn ensure:docs && yarn clear:cache && yarn scripts && nuxt dev --port=8000",
    "generate": "yarn preflight && yarn ensure:docs && yarn clear:cache && yarn scripts && nuxi generate",
    "netlify:generate": "mise settings add idiomatic_version_file_enable_tools node && yarn generate",
    "generate:serve": "yarn preflight && yarn ensure:docs && yarn scripts && nuxt generate && npx serve .output/public",
    "preview": "nuxt preview",
    "scripts": "yarn preflight && yarn create:contentDirectory && yarn create:manualPages && yarn create:news && yarn create:faqs && yarn create:pages && yarn create:resources && yarn create:hub && yarn create:hubImages && yarn create:routes && yarn create:searchIndex && yarn create:sitemap",
    "test": "node ./test/run-all-tests.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:run": "vitest run",
    "audit:a11y": "node ./audit-accessibility.js",
    "docs:all": "yarn audit:a11y",
    "postinstall": "nuxt prepare"
  },
  "resolutions": {
    "string-width": "4.2.3"
  },
  "devDependencies": {
    "@nuxt/content": "2.13.4",
    "@nuxt/devtools": "^3.1.1",
    "@nuxtjs/google-fonts": "3.2.0",
    "@nuxtjs/plausible": "2.0.1",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/compiler-sfc": "^3.5.17",
    "@vueuse/nuxt": "^14.1.0",
    "axe-core": "^4.11.0",
    "consola": "3.4.2",
    "font-awesome": "4.7.0",
    "happy-dom": "^20.0.2",
    "material-design-icons-iconfont": "6.7.0",
    "nuxt": "^4.0.0",
    "puppeteer": "^24.34.0",
    "typescript": "5.8.3",
    "vitest": "^2.1.0",
    "xml2js": "^0.6.2"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "6.6.0",
    "@mdi/font": "7.4.47",
    "@nuxt/image": "1.10.0",
    "@vueuse/components": "^14.1.0",
    "@vueuse/core": "^14.1.0",
    "@vueuse/integrations": "^14.1.0",
    "@vueuse/router": "^14.1.0",
    "aos": "2.3.4",
    "axios": "1.10.0",
    "dompurify": "3.2.6",
    "fs-extra": "^11.3.0",
    "fuse.js": "7.0.0",
    "is-buffer": "2.0.5",
    "kill-port": "2.0.1",
    "loading-attribute-polyfill": "2.1.1",
    "markdown-it": "14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "4.3.1",
    "mitt": "3.0.1",
    "moment": "2.30.1",
    "prettier": "3.3.3",
    "sass": "1.79.4",
    "sitemap": "8.0.0",
    "slugify": "1.6.6",
    "uuid": "11.1.0",
    "vite-plugin-vuetify": "^2.1.2",
    "vue-chartjs": "5.3.1",
    "vuetify": "^3.11.3",
    "yaml": "2.5.1"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}