{
  "$schema": "https://typedoc.org/schema.json",
  "tsconfig": "./typedoc.tsconfig.json",
  "entryPoints": [
    "composables/**/*.{ts,js}",
    "plugins/**/*.{ts,js}",
    "middleware/**/*.{ts,js}",
    "server/**/*.{ts,js}",
    "creators/**/*.{ts,js,mjs}"
  ],
  "entryPointStrategy": "expand",
  "out": "public/docs/jsdoc",
  "name": "R3 Restore, Reinvest, Renew - API Documentation",
  "readme": "none",
  "includeVersion": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "excludeNotDocumented": false,
  "exclude": ["**/*.vue", "**/*.test.*", "**/*.spec.*", "**/sandbox.js"],
  "navigationLinks": {
    "Main Site": "/index.html",
    "Documentation Portal": "/docs/index.html"
  }
}


